# ─────────────────────────────────────────────────────────────
# SMTP configuration for the contact form (server-side only).
# Copy this file to ".env.local" and fill in real values.
# The site builds & runs WITHOUT these set — the contact form
# will simply return a graceful "email service not configured"
# error until valid credentials are provided.
# ─────────────────────────────────────────────────────────────

# Your SMTP host, e.g. smtp.gmail.com, smtp.zoho.com, smtp.hostinger.com
SMTP_HOST=

# Usually 465 (secure/SSL) or 587 (STARTTLS)
SMTP_PORT=465

# true for port 465, false for 587
SMTP_SECURE=true

# SMTP account username (often the full email address)
SMTP_USER=

# SMTP account password or app-specific password
SMTP_PASS=

# The "From" address shown on delivered mail (often same as SMTP_USER)
SMTP_FROM="Obee's Fitness Center <no-reply@obeesfitness.com>"

# Where contact-form submissions are delivered
CONTACT_TO=malikbabarali520@gmail.com

# Public canonical site URL (used for metadata / sitemap / robots)
NEXT_PUBLIC_SITE_URL=https://www.obeesfitness.com
